# Used by docker-compose for the app and worker containers.
TRUSTLINE_ENV=dev
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://trustline:trustline@postgres:5432/trustline?sslmode=disable
REDIS_URL=redis://redis:6379/0
WEB_DIST=/app/web
GOOGLE_OAUTH_MODE=fake
MAIL_MODE=smtp
SMTP_ADDR=mailpit:1025
MAIL_FROM=Trustline <no-reply@trustline.local>
ENCRYPTION_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
SCHEDULER_INTERVAL=20s
BLOB_MODE=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=trustline-evidence
S3_ACCESS_KEY=trustline
S3_SECRET_KEY=trustline123
S3_PATH_STYLE=true
AI_MODE=fake
AI_MODEL=claude-sonnet-4-6
