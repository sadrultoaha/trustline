# Copy to .env for `make dev` (the Go API runs on the host, infra in docker).
TRUSTLINE_ENV=dev                      # dev | test | prod
HTTP_ADDR=:8080
BASE_URL=http://localhost:5173         # where the browser reaches the app (Vite in dev)
DATABASE_URL=postgres://trustline:trustline@localhost:5432/trustline?sslmode=disable
REDIS_URL=redis://localhost:6380/0
WEB_DIST=                              # leave empty in dev; Vite serves the SPA
SECURE_COOKIES=false
SESSION_TTL=720h

GOOGLE_OAUTH_MODE=fake                 # fake | real
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_MODE=smtp                         # smtp | memory
SMTP_ADDR=localhost:1025               # mailpit
MAIL_FROM=Trustline <no-reply@trustline.local>

ENCRYPTION_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef   # 32+ bytes; required in prod
SCHEDULER_INTERVAL=1m                  # connector sync cadence (Phase 1); 1h in prod
WORKER_QUEUE_DEFAULT=10
LOG_FORMAT=text                        # text | json
